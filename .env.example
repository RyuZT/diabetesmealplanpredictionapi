APP_NAME=Diabetes Meal Plan Inference API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# CORS for browser clients only. Keep narrow in production.
# For native mobile apps, CORS is usually not needed.
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

MODEL_DIR=app/models
DATA_DIR=app/data
MODEL_FILENAME=best_xgb.pkl
SCALER_FILENAME=scaler.pkl
LABEL_ENCODER_FILENAME=label_encoder.pkl
FOOD_DATA_FILENAME=foods_prepared.csv

# Reverse proxy (Caddy) for no-domain VPS setup
CADDY_SITE_ADDRESS=:80
PROXY_HTTP_PORT=80

# Uvicorn tuning (start with 1 for ML-heavy API)
UVICORN_WORKERS=1

# Restrict trusted proxy source ranges used by Uvicorn forwarded headers.
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,127.0.0.1
